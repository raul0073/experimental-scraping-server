{"league": "ITA-Serie A", "seasons": ["2324", "2425", "2526", "2627"], "min_share": 13.0, "period_minutes": {"2324": 3770, "2425": 3728, "2526": 3746, "2627": 501, "total": 11694}, "views": [{"key": "total", "label": "All seasons"}, {"key": "2627", "label": "2026/27"}, {"key": "2526", "label": "2025/26"}, {"key": "2425", "label": "2024/25"}, {"key": "2324", "label": "2023/24"}], "buckets": [{"key": "GK", "label": "Goalkeeper", "short": "GK", "desc": "The goalkeeper."}, {"key": "FB", "label": "Full-back", "short": "FB", "desc": "The full-backs of a back four — DR and DL."}, {"key": "CB", "label": "Centre-back", "short": "CB", "desc": "Centre-backs, whether in a two or a three."}, {"key": "WB", "label": "Wing-back", "short": "WB", "desc": "Wing-backs. The widest players on the pitch, wider than a winger and a line deeper — their team almost never fields a winger at all. The smallest pool on the site at 36, so read the percentiles as noisier here than elsewhere."}, {"key": "DM", "label": "Defensive midfield", "short": "DM", "desc": "The holding midfielder, in front of the defence."}, {"key": "CM", "label": "Central midfield", "short": "CM", "desc": "Central midfield proper, in the middle band."}, {"key": "AM", "label": "Attacking midfield", "short": "AM", "desc": "The creator behind the striker — including the two inside forwards of a 3-4-2-1, who lean left and right but work the half-space rather than the touchline."}, {"key": "WIDE", "label": "Attacking winger", "short": "AW", "desc": "Attacking wingers. MR/ML, AMR/AML and FWR/FWL are one job under three formation labels — Salah is AMR in a 4-2-3-1 and FWR in a 4-3-3 — so they are ranked together, with the side kept as a label rather than as a separate pool."}, {"key": "ST", "label": "Striker", "short": "ST", "desc": "The central striker."}], "sides": {"R": "right", "L": "left", "C": "centre"}, "metric_groups": [{"key": "decisive", "label": "Decisive acts"}, {"key": "intent", "label": "Intent on the ball"}, {"key": "