at change the side of the pitch."}, {"key": "longball_pct", "label": "Long balls that stick", "unit": "%", "group": "progression", "invert": false, "desc": "Completion rate of long passes."}, {"key": "pass_90", "label": "On the ball", "unit": "/90", "group": "possession", "invert": false, "desc": "Passes attempted per 90 — involvement, not quality."}, {"key": "pass_pct", "label": "Keeps possession", "unit": "%", "group": "possession", "invert": false, "desc": "Pass completion. Flattered by safe, short passing."}, {"key": "touch_box_90", "label": "Touches in the box", "unit": "/90", "group": "possession", "invert": false, "desc": "Any touch inside the opposition penalty area."}, {"key": "ground_duel_90", "label": "Ground duels", "unit": "/90", "group": "duels", "invert": false, "desc": "Tackles and challenges contested per 90 — duels on the floor, air excluded."}, {"key": "ground_duel_pct", "label": "Ground duels won", "unit": "%", "group": "duels", "invert": false, "desc": "Share of ground duels won. A challenge is a duel he was beaten in, so it counts against."}, {"key": "aerial_90", "label": "Aerial duels", "unit": "/90", "group": "duels", "invert": false, "desc": "All aerial duels contested per 90, both ends."}, {"key": "aerial_pct", "label": "Aerial duels won", "unit": "%", "group": "duels", "invert": false, "desc": "Share of aerial duels won."}, {"key": "aerial_def_90", "label": "Defensive headers", "unit": "/90", "group": "duels", "invert": false, "desc": "Aerial duels contested while defending. Not available from free sources before events."}, {"key": "aerial_def_pct", "label": "Defensive headers won", "unit": "%", "group": "duels", "invert": false, "desc": "Win rate in defensive aerial duels."}, {"key": "aerial_att_90", "label": "Attacking headers", "unit": "/90", "group": "duels", "invert": false, "desc": "Aerial duels contested while attacking."}, {"key": "aerial_att_pct", "label": "Attacking headers won", "unit": "%", "group": "duels", "invert": false, "d